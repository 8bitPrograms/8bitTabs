{
  "manifest_version": 3,
  "name": "8bitTabs — Private Tab Archive",
  "version": "1.3.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "unlimitedStorage"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Archive tabs · Pinned tabs follow your settings",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_ui": { "page": "manager.html", "open_in_tab": true },
  "commands": {
    "open-library": { "suggested_key": { "default": "Alt+Shift+O" }, "description": "Open archive (keeps tabs open)" }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  }
}
